<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.miyoshi.conversate-sync</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Mac mini は Command Line Tools 未導入で /usr/bin/python3 が動かない -->
        <string>/usr/local/bin/python3</string>
        <string>/Users/miyoshi/even-conversate/poller/conversate_sync.py</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- claude は Homebrew ではなく .local/bin にある -->
        <key>PATH</key>
        <string>/Users/miyoshi/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Vault の実体があるホスト。Mac mini 上で動かすなら 127.0.0.1 -->
        <key>OBSIDIAN_HOST</key>
        <string>127.0.0.1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/miyoshi/Library/Logs/conversate-sync.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/miyoshi/Library/Logs/conversate-sync.err.log</string>
</dict>
</plist>
